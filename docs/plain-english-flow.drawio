<mxfile host="app.diagrams.net"><diagram name="Plain English skills"><mxGraphModel dx="2520" dy="1330" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Plain English skills for Claude Code" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1400" height="44" as="geometry"/></mxCell><mxCell id="lg" value="LEGEND&#10;&#10;Green ellipse   what starts it&#10;Blue box        the artifact that runs&#10;Orange doc      what you get back&#10;Yellow cylinder a file on disk&#10;Red diamond     a pass or fail check&#10;&#10;Dashed frame    one of the three jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="560" height="208" as="geometry"/></mxCell><mxCell id="sp" value="THE SPLIT, AND WHY IT IS A SPLIT&#10;&#10;A recap that also recommends is two jobs in one message,&#10;and the recommendation crowds out the caveat. So the&#10;restating half may never recommend, and the recommending&#10;half may never dump the whole board.&#10;&#10;They share one thing: the vocabulary rule. It has a single&#10;owner, so the two cannot drift apart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="86" width="880" height="208" as="geometry"/></mxCell><mxCell id="in" value="INSTALL&#10;&#10;cp -r explain-simply write-in-ste ~/.claude/skills/&#10;cp commands/next-step.md ~/.claude/commands/&#10;&#10;Check the checker runs:&#10;python3 ~/.claude/skills/write-in-ste/ste_check.py --selftest&#10;&#10;Python 3 only. No third-party packages." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1540" y="86" width="900" height="208" as="geometry"/></mxCell><mxCell id="A" value="A.  Restate what was just said" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="740" height="560" as="geometry"/></mxCell><mxCell id="B" value="B.  Decide what to do next" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="330" width="740" height="560" as="geometry"/></mxCell><mxCell id="C" value="C.  Rewrite a document" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1640" y="330" width="800" height="560" as="geometry"/></mxCell><mxCell id="a1" value="You did not follow the last report" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="392" width="340" height="64" as="geometry"/></mxCell><mxCell id="a2" value="/explain-simply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="512" width="340" height="64" as="geometry"/></mxCell><mxCell id="a3" value="Plain recap, then what is still open" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="340" height="74" as="geometry"/></mxCell><mxCell id="a4" value="HARD RULE&#10;&#10;Translation only.&#10;&#10;No tool calls.&#10;No re-checking.&#10;No caveat softened&#10;to make it fit.&#10;No next step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="250" height="214" as="geometry"/></mxCell><mxCell id="b1" value="What should I work on now?" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="392" width="340" height="64" as="geometry"/></mxCell><mxCell id="b2" value="/next-step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="512" width="340" height="64" as="geometry"/></mxCell><mxCell id="b3" value="One pick, one reason, the command to start it" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="640" width="340" height="74" as="geometry"/></mxCell><mxCell id="b4" value="READS, CHEAPLY&#10;&#10;The project TODO.md&#10;Git state&#10;Open pull requests&#10;Last shipped note&#10;&#10;Skips a missing one&#10;and says so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="500" width="250" height="214" as="geometry"/></mxCell><mxCell id="c1" value="An install guide or a handover document" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1720" y="392" width="340" height="64" as="geometry"/></mxCell><mxCell id="c2" value="/write-in-ste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1720" y="512" width="340" height="64" as="geometry"/></mxCell><mxCell id="c3" value="ste_check.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1720" y="640" width="340" height="64" as="geometry"/></mxCell><mxCell id="c4" value="exit 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2180" y="616" width="220" height="104" as="geometry"/></mxCell><mxCell id="c5" value="Rewritten document, plus an honest claim" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2100" y="790" width="310" height="80" as="geometry"/></mxCell><mxCell id="s1" value="The words to strip&#10;owned by /explain-simply" style="shape=cylinder3;boundedLbl=1;size=15;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="960" width="420" height="100" as="geometry"/></mxCell><mxCell id="s2" value="Plain English word list&#10;84 entries" style="shape=cylinder3;boundedLbl=1;size=15;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1720" y="960" width="340" height="100" as="geometry"/></mxCell><mxCell id="ft" value="WHAT A CLEAN RUN MAY CLAIM&#10;&#10;The ASD-STE100 approved-word dictionary is copyright ASD and is not in this repository. A local plain English list of 84 entries&#10;is installed instead, built from plainlanguage.gov (a US federal work, CC0 1.0). The checker prints which list it loaded on every&#10;run, so a local list and the official one can never look alike in the output.&#10;&#10;Honest wording: passes the structural rules, and word choice was checked against the local plain English list, so the document&#10;is plainer, not certified." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="2400" height="170" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="no, fix and re-run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2290" y="560"/></Array></mxGeometry></mxCell><mxCell id="e10" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="544"/><mxPoint x="80" y="1010"/></Array></mxGeometry></mxCell><mxCell id="e11" value="read by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="s1" target="b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="1010"/><mxPoint x="810" y="544"/></Array></mxGeometry></mxCell><mxCell id="e12" value="loads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>